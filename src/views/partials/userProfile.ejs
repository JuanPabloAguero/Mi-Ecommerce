<!-- views/partials/userProfile.ejs -->
<% const isLoggedIn = typeof currentUser !== 'undefined' && currentUser; %>
<div class="user-profile-dropdown">
  <button class="user-profile-btn" type="button">
    <i class="fas fa-user-circle"></i>
    <span><%= isLoggedIn ? currentUser.name : 'Ingresar' %></span>
  </button>

  <div class="dropdown-menu">
    <div class="dropdown-header">
      <i class="fas fa-user-circle"></i>
      <span><%= isLoggedIn ? currentUser.name : 'Visitante' %></span>
    </div>
    <ul class="dropdown-links">
      <li><a href="/">Inicio</a></li>

      <% if (!isLoggedIn) { %>
        <li><a href="/login"><i class="fas fa-sign-in-alt"></i> Iniciar Sesión</a></li>
        <li><a href="/register">Registrarse</a></li>
      <% } else { %>
        <li><a href="/orders">Mis Pedidos</a></li>
        <% if (currentUser.role === 'admin') { %>
          <li><a href="/admin">Administración</a></li>
        <% } %>
        <li>
          <form action="/logout" method="POST" style="margin: 0;">
            <button type="submit" class="dropdown-logout-btn">
              <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
            </button>
          </form>
        </li>
      <% } %>
    </ul>
    <div class="dropdown-footer">
      <button class="theme-toggle-btn" type="button">
        <i class="fas fa-gear"></i>
        <span>Cambiar a Tema Oscuro/Claro</span>
      </button>
    </div>
  </div>
</div>
