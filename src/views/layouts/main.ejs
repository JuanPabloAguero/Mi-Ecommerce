<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Título dinámico con fallback -->
  <title><%= typeof title !== 'undefined' ? `${title} - MiEcommerce` : 'MiEcommerce' %></title>
  
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

  <!-- Mostrar el estado de la conexión en la interfaz -->
<div id="ws-status-container" class="status-container">
  <span id="ws-status-dot" class="status-dot disconnected"></span>
  <span id="ws-status-text">Desconectado</span>
</div>

<!-- Script del cliente para WebSockets -->
<script src="/js/websocket.js"></script>

<!-- Notificación Toast para Carrito Vacío -->
<div id="cart-toast-notification" class="cart-toast hidden">
  <i class="fas fa-info-circle"></i>
  <span>El carrito ha sido vaciado.</span>
</div>

  <%- include('../partials/header') %>

  <%- body %>

  <%- include('../partials/footer') %>

</body>
</html>
