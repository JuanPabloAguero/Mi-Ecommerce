<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro - MiEcommerce</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  
  <%- include('../partials/header', { minimal: true }) %>

  <!-- Banner verde menta de fondo -->
  <div class="green-banner"></div>

  <main class="register-container">
    <h2>¡Registrate!</h2>
    
    <form action="/register" method="POST" class="register-form" novalidate>
      <!-- Contenedor para mensajes de error accesibles -->
      <div id="error-list" role="alert" aria-live="assertive"></div>

      <!-- Campo Nombre -->
      <div class="form-group">
        <label for="firstName">Nombre</label>
        <input 
          type="text" 
          id="firstName" 
          name="firstName" 
          placeholder="Tu nombre" 
          autocomplete="given-name" 
          required
        >
      </div>

      <!-- Campo Apellido -->
      <div class="form-group">
        <label for="lastName">Apellido</label>
        <input 
          type="text" 
          id="lastName" 
          name="lastName" 
          placeholder="Tu apellido" 
          autocomplete="family-name" 
          required
        >
      </div>

      <!-- Campo Email / Nombre de Usuario -->
      <div class="form-group">
        <label for="email">Email o nombre de usuario</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="ejemplo@correo.com" 
          autocomplete="username" 
          required
        >
      </div>

      <!-- Campo Contraseña -->
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Tu nueva contraseña" 
          autocomplete="new-password" 
          required
        >
      </div>

      <!-- Botón de Registro -->
      <button type="submit" class="btn-submit">Crear Cuenta</button>
    </form>

    <!-- Enlace a Login -->
    <div class="form-footer">
      <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/registerValidation.js"></script>
</body>
</html>
