<main class="cart-container" style="text-align: center; padding: 60px 20px;">
  <h1 style="font-size: 72px; margin-bottom: 10px; color: #1abc9c;">404</h1>
  <h2 style="font-size: 24px; font-weight: normal; margin-bottom: 20px; color: #333;">¡Uy! La página que buscas no existe.</h2>

  <!-- Renderizado dinámico del mensaje si existe -->
  <p style="color: #666; margin-bottom: 30px;">
    <%= typeof message !== 'undefined' ? message : 'Es posible que la dirección esté mal escrita o que la página haya sido movida.' %>
  </p>
  
  <a href="/" class="btn-checkout" style="display: inline-block;">Volver a la página principal</a>
</main>
