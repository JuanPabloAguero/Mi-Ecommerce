<main class="products-section" style="padding: 20px 50px; min-height: 50vh;">
  <!-- Título con el nombre de la categoría -->
  <h1 style="margin-bottom: 20px; text-transform: capitalize;">Categoría: <%= categoryName %></h1>

  <% if (products && products.length > 0) { %>
    <!-- Grilla de productos reutilizando la card -->
    <div class="product-grid">
      <% products.forEach(product => { %>
        <%- include('../partials/productCard', { product }) %>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Mensaje amigable si no hay productos en la categoría -->
    <div style="text-align: center; padding: 40px 0;">
      <p style="font-size: 18px; color: #666; margin-bottom: 20px;">
        No se encontraron productos disponibles en la categoría <strong>"<%= categoryName %>"</strong>.
      </p>
      <a href="/" class="btn-checkout" style="display: inline-block;">Volver al Inicio</a>
    </div>
  <% } %>
</main>
