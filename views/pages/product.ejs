<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalle de Producto - MiEcommerce</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
  
  <!-- Header -->
  <%- include('../partials/header') %>

  <!-- Barra superior con Búsqueda, Carrito y Usuario -->
  <div class="top-nav-actions" style="display: flex; align-items: center; justify-content: space-between; padding: 15px 50px;">
    <%- include('../partials/searchBar') %>
    <div style="display: flex; gap: 20px; align-items: center;">
      <%- include('../partials/cartIcon') %>
      <%- include('../partials/userProfile') %>
    </div>
  </div>

  <main class="product-page-container">
    
    <!-- Breadcrumb (Migas de pan: pequeño texto debajo para volver y con nombre de la categoría del producto) -->
    <div class="breadcrumb">
      <a href="/"><i class="fas fa-arrow-left"></i> Volver al listado</a> <span>&gt; Alimentos</span>
    </div>

    <!-- Sección Principal del Detalle -->
    <section class="product-detail-layout">
      
      <!-- Columna Izquierda: Galería -->
      <div class="product-gallery">
        <div class="gallery-thumbnails">
          <div class="thumb-img active"></div>
          <div class="thumb-img"></div>
          <div class="thumb-img"></div>
        </div>
        <div class="gallery-main-img"></div>
      </div>

      <!-- Columna Derecha: Información del Producto -->
      <div class="product-info-panel">
        <h1>Whiskey Jack Daniels Honey 750ml</h1>
        <div class="product-price-large">19.900 <span>PUNTOS</span></div>
        
        <button class="btn-add-cart">Agregar al Carrito</button>
        
        <div class="product-description">
          <p>Un verdaderamente fabuloso licor de whisky Jack Daniels. Está hecho con una mezcla de ricas especias y suave, miel tersa y el resultado es delicioso sobre hielo o café.</p>
          <p>Aroma de caramelo y roble carbonizado, un poco de flor de naranja, miel de manuka y vainilla.</p>
          <p>Boca: grueso y cremoso, con notas de vainilla, roble tostado, miel de nuevo, un poco de albaricoque también.</p>
          <p>Acabado: De buena longitud - redondeado y rico.</p>
          <p>No incluye vasos, la foto es sólo ilustrativa.</p>
        </div>
      </div>

    </section>

    <!-- Grilla de productos relacionados (BONUS US #6) -->
    <section class="products-section" style="padding: 0 0 20px 0;">
      <h2>También te puede interesar</h2>
      <div class="product-grid">
        <!-- Inyectamos 4 tarjetas usando el parcial -->
        <% for(let i=0; i<4; i++) { %>
          <%- include('../partials/productCard') %>
        <% } %>
      </div>
    </section>

  </main>

  <!-- Categorías Inferiores -->
  <%- include('../partials/categoriesBar') %>

  <!-- Footer -->
  <%- include('../partials/footer') %>

</body>
</html>
